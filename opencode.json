{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "ssh*": "allow",
      "scp*": "deny",
      "rsync*": "deny",
      "sftp*": "deny",
      "ssh*sed -i*": "deny",
      "ssh*tee *": "deny",
      "ssh*rm *": "deny",
      "ssh*mv *": "deny",
      "ssh*cp *": "deny",
      "ssh*touch *": "deny",
      "ssh*mkdir *": "deny",
      "ssh*chmod *": "deny",
      "ssh*chown *": "deny",
      "ssh*git pull*": "deny",
      "ssh*git push*": "deny",
      "ssh*git reset*": "deny",
      "ssh*git checkout*": "deny",
      "ssh*git commit*": "deny",
      "ssh*docker compose*up*": "deny",
      "ssh*docker compose*down*": "deny",
      "ssh*docker compose*restart*": "deny",
      "ssh*docker compose*stop*": "deny",
      "ssh*docker compose*start*": "deny",
      "ssh*docker compose*build*": "deny",
      "ssh*docker compose*pull*": "deny",
      "ssh*docker compose*exec -T pi*sh -c*": "deny"
    }
  }
}