{
  "name": "pi-huggingface-image-gen",
  "version": "0.1.0",
  "description": "Pi extension exposing HuggingFace Inference image generation as a native Pi tool (hf_generate_image).",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@huggingface/inference": "^3.8.3",
    "@sinclair/typebox": "^0.34.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}