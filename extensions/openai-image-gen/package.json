{
  "name": "pi-openai-image-gen",
  "version": "0.1.0",
  "description": "Local Pi extension exposing OpenAI-compatible image generation as a native Pi tool (generate_image). Drawer fallback.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}