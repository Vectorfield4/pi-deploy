# AI provider chat key (used by Pi agents via .pi/models.json)
TIMEWEB_API_KEY=

# dense-mem PostgreSQL — auto-generated by make init if empty
POSTGRES_PASSWORD=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GitHub
GITHUB_TOKEN=

# Vercel (optional)
VERCEL_TOKEN=
VERCEL_ORG_ID=

# FTP (optional)
FTP_HOST=
FTP_USER=
FTP_PASS=

# Context7 (optional — works without key at IP-based rate limits)
CONTEXT7_API_KEY=

# Telegram outbound routing (RU/VPS workaround)
# Route api.telegram.org via an HTTPS CONNECT proxy (e.g. gost on a free-tier
# Oracle VM outside RU). Node 24 honors these via NODE_USE_ENV_PROXY=1.
# Leave blank to connect directly. Example:
#   HTTPS_PROXY=http://user:pass@203.0.113.10:3128
NODE_USE_ENV_PROXY=1
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,dense-mem,memory-db

# Telegram group mention trigger (pi-telegram-bridge). Defaults to bot username
# from getMe, or "@pi". Set explicitly to pin match in groups e.g.:
TELEGRAM_MENTION=@your_bot_username

# dense-mem
# Control portal token — auto-resolved by memory-bootstrap.sh if not set
# (tries docker container, then control portal default). Set manually if preferred.
CONTROL_PORTAL_TOKEN=
# DENSE_MEM_API_KEY — auto-filled by running: bash scripts/memory-bootstrap.sh
# (requires dense-mem stack running and CONTROL_PORTAL_TOKEN available)
DENSE_MEM_API_KEY=
# Host port that maps to dense-mem's container port 8080 (MCP/API). Change if busy.
DENSE_MEM_PORT=8080
# Host port that maps to dense-mem's container port 8090 (Control Portal).
CONTROL_PORTAL_PORT=8090
# Team name for dense-mem (used by memory-bootstrap.sh)
TEAM_NAME=pi-coder
# Credential name for dense-mem API key (used by memory-bootstrap.sh)
CREDS_NAME=default

# dense-mem AI providers
# Embeddings
AI_API_URL=
AI_API_KEY=
AI_API_EMBEDDING_MODEL=
AI_API_EMBEDDING_DIMENSIONS=

# Verifier (leave AI_VERIFIER_API_URL/KEY empty to reuse Embeddings)
AI_VERIFIER_API_URL=
AI_VERIFIER_API_KEY=
AI_VERIFIER_MODEL=
AI_VERIFIER_TIMEOUT_SECONDS=300

# ---- Tracing (pi-otel-telemetry -> Jaeger) ----
# OTLP/HTTP endpoint for trace + metric export. Defaults to the in-stack jaeger service.
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SERVICE_NAME=pi-agent
# Set to false to disable the pi-otel-telemetry extension entirely.
PI_OTEL_ENABLED=true
# Host port for the Jaeger UI (loopback only).
JAEGER_UI_PORT=16686
