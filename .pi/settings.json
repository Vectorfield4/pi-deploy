{
  "defaultProvider": "timeweb",
  "defaultModel": "deepseek/deepseek-v4-flash",
  "theme": "dark",
  "compaction": {
    "enabled": true,
    "reserveTokens": 8192,
    "keepRecentTokens": 16000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000
  },
  "subagents": {
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "timeweb/deepseek/deepseek-v4-flash",
        "timeweb/deepseek/deepseek-v4-pro"
      ]
    }
  },
  "packages": [
    "npm:pi-subagents@0.58.0",
    "npm:pi-mcp-adapter@2.29.0",
    "npm:@bytesbrains/pi-telegram-bridge@1.4.1",
    "npm:ping-a-human-pi@0.1.1",
    "npm:pi-memory@0.4.2",
    "npm:@upstash/context7-pi@0.1.2",
    "npm:@vectorfield/pi-prs@0.1.1"
  ]
}
