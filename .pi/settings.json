{
  "defaultProvider": "timeweb",
  "defaultModel": "deepseek/deepseek-v4-flash",
  "defaultProjectTrust": "prompt",
  "theme": "dark",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 35000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000
  },
  "packages": [
    "npm:pi-subagents@0.57.0",
    "npm:pi-mcp-adapter@2.29.0",
    "npm:pi-monitor@0.1.0",
    "npm:@bytesbrains/pi-telegram-bridge@1.4.1",
    "npm:ping-a-human-pi@0.1.1",
    "npm:pi-memory@0.4.2",
    "npm:@upstash/context7-pi@0.1.2"
  ]
}
