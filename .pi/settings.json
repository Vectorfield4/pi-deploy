{
  "defaultProvider": "timeweb",
  "defaultModel": "deepseek/deepseek-v4-flash",
  "defaultTools": ["ls", "read"],
  "defaultThinkingLevel": "off",
  "theme": "dark",
  "compaction": {
    "enabled": true,
    "reserveTokens": 8192,
    "keepRecentTokens": 12000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000
  },
  "subagents": {
    "maxSubagentDepth": 4,
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "timeweb/deepseek/deepseek-v4-flash"
      ]
    }
  },
  "packages": [
    "npm:pi-subagents@0.58.0",
    "npm:@bytesbrains/pi-telegram-bridge@1.4.1",
    "npm:ping-a-human-pi@0.1.1",
    "npm:pi-memory@0.4.2",
    "npm:@upstash/context7-pi@0.1.2",
    "npm:pi-tree-sitter@0.2.8",
    "/extensions/pi-pgvector-memory",
    "/extensions/huggingface-image-gen",
    "/extensions/openai-image-gen",
    "npm:pi-otel-telemetry@1.0.0"
  ]
}
