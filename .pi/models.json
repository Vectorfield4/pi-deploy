{
  "providers": {
    "timeweb": {
      "api": "openai-completions",
      "baseUrl": "https://api.timeweb.ai/v1",
      "apiKey": "$TIMEWEB_API_KEY",
      "models": [
        {
          "id": "deepseek/deepseek-v4-flash",
          "name": "DeepSeek V4 Flash",
          "reasoning": true,
          "contextWindow": 1000000,
          "maxTokens": 384000
        }
      ]
    },
    "image": {
      "api": "openai-completions",
      "baseUrl": "$IMAGE_API_URL",
      "apiKey": "$IMAGE_API_KEY",
      "models": [
        {
          "id": "gemini/gemini-3.1-flash-image-preview",
          "name": "Gemini 3.1 Flash Image Preview",
          "output": ["image"],
          "imageApi": "google-generative-ai-image",
          "imageCost": 0
        },
        {
          "id": "black_forest_labs/flux-2-pro",
          "name": "FLUX.2 [pro]",
          "output": ["image"],
          "imageApi": "openai-chat-image",
          "imageCost": 0
        }
      ]
    }
  }
}
