FROM node:24-bookworm-slim

# --- GitHub CLI (gh) + base system packages ---
# See scripts/install-github-cli.sh. gh is needed by the release/deploy skills
# for `gh pr create/merge` and `gh release`. Release PR approval HITL is handled
# zero-token by @vectorfield/pi-prs (/pr watch), not by gh polling.
COPY scripts/install-github-cli.sh /usr/local/bin/install-github-cli.sh
RUN chmod +x /usr/local/bin/install-github-cli.sh \
  && /usr/local/bin/install-github-cli.sh \
  && rm /usr/local/bin/install-github-cli.sh

RUN npm install -g @earendil-works/pi-coding-agent \
  && npm install -g @tobilu/qmd \
  && apt-get update \
  && apt-get install -y --no-install-recommends procps \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
ENTRYPOINT ["pi", "-a"]
