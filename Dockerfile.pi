FROM node:24-bookworm-slim

# --- GitHub CLI (gh) + base system packages ---
# See scripts/install-github-cli.sh. gh is needed by the release/deploy
# skills for `gh release create` / `gh api` (release + CI lookups) and by the
# coder/reviewer for git push auth. Direct push to main; no PR watch.
COPY scripts/install-github-cli.sh /usr/local/bin/install-github-cli.sh
RUN chmod +x /usr/local/bin/install-github-cli.sh \
  && /usr/local/bin/install-github-cli.sh \
  && rm /usr/local/bin/install-github-cli.sh

RUN npm install -g @earendil-works/pi-coding-agent \
  && npm install -g @tobilu/qmd \
  && apt-get update \
  && apt-get install -y --no-install-recommends procps python3 \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

COPY scripts/pi-entrypoint.sh /usr/local/bin/pi-entrypoint.sh
RUN chmod +x /usr/local/bin/pi-entrypoint.sh

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/pi-entrypoint.sh", "-a"]
